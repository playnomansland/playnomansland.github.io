{
  "_about": "The keyword registry (phase 1 of the design plan, 2026-11-12). One list of keywords that every screen, the Units page and the docs are meant to read from. Nothing in the game reads this file yet: it changes no rules and no screens. Checked by tools/tests/keywords.js, which also writes docs/KEYWORDS-TAGGING.md. Not the same file as src/keywords.json (that one feeds the Miro board).",
  "rules": {
    "maxWords": 8,
    "wave1Cap": 17,
    "kit": ["icon", "fx", "sound", "demo"],
    "_kit": "Every keyword ships as a kit: an icon, a role colour (from its role), an effect seen on bodies in the fight (fx), a sound, a three-second demo on the island, and a line of at most maxWords words. null = not made yet."
  },
  "roles": {
    "_about": "A keyword's role is shown as its icon's colour, never as a second tag. Colours are placeholders until the icon set is drawn.",
    "damage":  { "name": "Damage",  "color": "#E07A6A", "line": "Kills things." },
    "guard":   { "name": "Guard",   "color": "#7FA8D9", "line": "Protects the line." },
    "control": { "name": "Control", "color": "#B79AE0", "line": "Moves or turns enemies." },
    "afflict": { "name": "Afflict", "color": "#A8C97A", "line": "Puts effects on enemies." },
    "support": { "name": "Support", "color": "#6FD3DE", "line": "Helps your own side." },
    "summon":  { "name": "Summon",  "color": "#E0B25A", "line": "Brings more bodies." }
  },
